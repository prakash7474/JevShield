{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JevShield Studio",
  "version": "0.2.0",
  "identifier": "ai.typesafe.jevshield.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JevShield Studio",
        "width": 1680,
        "height": 1020,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visual IDE and debugger for Jev decision pipelines"
  }
}
