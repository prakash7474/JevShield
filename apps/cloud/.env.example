# --- JevShield Cloud Gateway ------------------------------------------------
# Database
DATABASE_URL=postgresql://jevshield:secret_password@localhost:5432/jevshield_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Gateway
PORT=4000
HOST=0.0.0.0

# API Keys (forwarded to upstream providers)
TYPESAFE_API_KEY=ts_live_xxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=

# Telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9464

# Security
API_KEY_SALT=change-me-in-production
HITL_CONFIDENCE_THRESHOLD=0.70
