# --- JevShield Core ---------------------------------------------------------
# Required. Read automatically by JevShield when `apiKey` is not passed.
TYPESAFE_API_KEY=ts_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides ---------------------------------------------------------
# TYPESAFE_BASE_URL=https://api.typesafe.ai
# JEVD_MODEL=jev-latest
# JEVD_FALLBACK_ENDPOINT=https://my-gateway/v1/chat/completions

# Generative fallback (only needed when a fallback provider is enabled)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Confidence below which JevShield escalates to the fallback provider.
JEVD_CONFIDENCE_THRESHOLD=0.6
